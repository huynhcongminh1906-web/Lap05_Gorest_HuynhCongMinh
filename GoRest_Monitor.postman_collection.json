{
  "info": {
    "_postman_id": "88d791f2-5836-4c5d-967d-e0aedf22dcf4",
    "name": "MSSV_HoTen_GoRest_Monitor",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /users - Health & Response Time",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time < 800ms', () => pm.expect(pm.response.responseTime).to.be.below(800));",
              "pm.test('Response la mang JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    }
  ]
}